  "acceptance_matrix": [
    {
      "id": "ACC-01",
      "requirement": "integrated_delivery",
      "threshold": "1 robot, 1 LFP accumulator, 1 charger, software and technical package",
      "evidence": "inspection_and_delivery_record",
      "waiver": "not_for_mandatory_missing_items"
    },
    {
      "id": "ACC-02",
      "requirement": "energy_runtime",
      "threshold": ">=4.0 h at the agreed 200 W profile",
      "evidence": "energy_soc_voltage_temperature_power_and_event_logs_plus_witnessed_FAT",
      "waiver": "none"
    },
    {
      "id": "ACC-03",
      "requirement": "accumulator_swap",
      "threshold": "<=5 min, controls active, no arc, reboot or state loss",
      "evidence": "timer_video_and_logs_three_repetitions",
      "waiver": "none_for_unsafe_condition"
    },
    {
      "id": "ACC-04",
      "requirement": "estop_and_motor_inhibit",
      "threshold": "safe state, no automatic restart",
      "evidence": "oscilloscope_logs_video_and_fault_injection",
      "waiver": "none"
    },
    {
      "id": "ACC-05",
      "requirement": "uncontrolled_motion",
      "threshold": "zero_events",
      "evidence": "hazard_and_defect_log",
      "waiver": "none"
    },
    {
      "id": "ACC-06",
      "requirement": "navigation_and_coverage",
      "threshold": ">=95% reachable area, zero collisions, >=9/10 completed missions",
      "evidence": "ground_truth_map_rosbag_and_coverage_report",
      "waiver": "class_3_only_never_for_unsafe_collision"
    },
    {
      "id": "ACC-07",
      "requirement": "localization",
      "threshold": "RMS <=0.20 m and relocalization <=30 s",
      "evidence": "ground_truth_rosbag_and_report",
      "waiver": "class_3_before_FAT"
    },
    {
      "id": "ACC-08",
      "requirement": "cleaning_and_irrigation",
      "threshold": ">=90% agreed soil removal, flow within +/-15%, zero leaks toward electronics",
      "evidence": "before_after_flow_measurement_inspection_and_leak_test",
      "waiver": "none_for_leak_toward_electronics"
    },
    {
      "id": "ACC-09",
      "requirement": "perception",
      "threshold": ">=90% recall and <=10% false positives on frozen classes",
      "evidence": "versioned_dataset_replay_and_physical_tests",
      "waiver": "class_3_before_FAT"
    },
    {
      "id": "ACC-10",
      "requirement": "connectivity",
      "threshold": "state recovery <=60 s and >=99% expected telemetry logged",
      "evidence": "robot_and_backend_logs",
      "waiver": "class_3_before_FAT"
    },
    {
      "id": "ACC-11",
      "requirement": "electrical_and_thermal_safety",
      "threshold": "no unexpected trips, cells out of limits, over-rated conductors or water in electronics",
      "evidence": "thermal_electrical_logs_inspection_fault_and_leak_tests",
      "waiver": "none"
    },
    {
      "id": "ACC-12",
      "requirement": "documentation",
      "threshold": "100% versioned technical package",
      "evidence": "release_configuration_checklist",
      "waiver": "P2_editorial_only"
    }
  ],
